---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/projects/ProjectCard.astro";
import ProjectFilter from "../components/projects/ProjectFilter";
import { projectCategories, projects } from "../data/info";
import { sortFeaturedFirst } from "../lib/projects";
import "../styles/projects.css";

export const prerender = true;

const orderedProjects = sortFeaturedFirst(projects);
const featured = orderedProjects.filter((project) => project.featured);
const others = orderedProjects.filter((project) => !project.featured);
---

<Layout
  title="Side Projects | Nicolas Moreno"
  description="Proyectos reales de Nicolás Moreno: agentes de IA, sistemas IoT, seguridad, herramientas CLI, automatización y aplicaciones móviles construidas con código."
>
  <section class="projects-page" aria-labelledby="projects-title">
    <header class="projects-intro">
      <span class="projects-intro__label">PROJECT LOG</span>
      <h1 id="projects-title">Side projects</h1>
      <p>Builds, systems and tools from the working archive.</p>
    </header>

    <ProjectFilter categories={projectCategories} client:visible />

    <section class="projects-group" aria-labelledby="featured-title">
      <h2 id="featured-title" class="projects-group__title">Featured</h2>
      <div class="projects-featured">
        {featured.map((project, index) => <ProjectCard project={project} variant="poster" eager={index === 0} />)}
      </div>
    </section>

    <section class="projects-group" aria-labelledby="more-title">
      <h2 id="more-title" class="projects-group__title">More builds</h2>
      <div class="projects-grid">
        {others.map((project) => <ProjectCard project={project} variant="ticket" />)}
      </div>
    </section>
  </section>
</Layout>
