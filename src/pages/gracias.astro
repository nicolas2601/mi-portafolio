---
import Layout from "../layouts/Layout.astro";
import "../styles/contact.css";
---

<Layout
  title="Message received | Nicolas Moreno"
  description="Tu mensaje fue enviado correctamente. Gracias por contactar a Nicolás Moreno. Puedes volver al inicio o revisar su experiencia y habilidades."
>
  <div class="thanks-page">
    <section class="thanks-panel" aria-labelledby="thanks-title">
      <p class="contact-kicker">03 / TRANSMISSION COMPLETE</p>
      <h1 id="thanks-title">Message received</h1>
      <p>Gracias por contactar a Nicolás Moreno. Tu mensaje fue enviado correctamente.</p>
      <div class="thanks-actions">
        <a href="/">Return home</a>
        <a href="/resume">View resume</a>
      </div>
    </section>
  </div>
</Layout>
