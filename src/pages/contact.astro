---
import Layout from "../layouts/Layout.astro";
import Contact from "../components/Contact";
import ContactDetails from "../components/contact/ContactDetails.astro";
import "../styles/contact.css";

export const prerender = true;
const nextUrl = new URL("/gracias", Astro.site).toString();
---

<Layout
  title="Contact | Nicolas Moreno | Build Systems Together"
  description="Contacta a Nicolás Moreno para hablar sobre desarrollo backend, sistemas web y automatización. Escríbele por formulario, email o redes."
>
  <div class="contact-page">
    <header class="contact-intro">
      <p class="contact-kicker">NM / CONTACT PROTOCOL</p>
      <h1>Contact</h1>
      <p>Hablemos de sistemas web, backend y automatización.</p>
    </header>

    <div class="contact-layout">
      <ContactDetails />
      <section class="contact-form-panel" aria-labelledby="contact-form-title">
        <Contact client:load nextUrl={nextUrl} />
      </section>
    </div>
  </div>
</Layout>
