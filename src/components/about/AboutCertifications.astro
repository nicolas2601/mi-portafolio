---
import { groupCertifications } from "../../lib/certifications";
import type { Certification } from "../../lib/certifications";
import "../../styles/credentials.css";

interface Props {
  items: Certification[];
}

const { items } = Astro.props;
const groups = groupCertifications(items);
---

<section class="about-section credentials-teaser" aria-labelledby="certifications-title">
  <div class="about-section-heading about-section-heading-wide">
    <p class="about-index">04 / CLEARANCE</p>
    <h2 id="certifications-title">Certifications</h2>
  </div>

  <ul class="credentials-teaser__issuers">
    {groups.map((group) => (
      <li>
        <strong>{group.items.length}</strong>
        <span>{group.issuer}</span>
      </li>
    ))}
  </ul>
  <p class="credentials-teaser__note">
    Networking, cybersecurity, cloud, data and AI courses, plus an English proficiency exam.
    <a href="/resume#credentials">See every credential</a>
  </p>
</section>
