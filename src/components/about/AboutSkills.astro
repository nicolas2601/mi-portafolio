---
type Skill = { name: string };
type SkillGroups = Record<string, Skill[]>;

interface Props {
  groups: SkillGroups;
}

const { groups } = Astro.props;
const groupLabels: Record<string, string> = {
  backend: "Backend",
  frontend: "Frontend",
  databases: "Databases",
  automationAndCloud: "Automation & Cloud",
};
---

<section class="about-section about-skills" aria-labelledby="skills-title">
  <div class="about-section-heading">
    <p class="about-index">05 / LOADOUT</p>
    <h2 id="skills-title">Skills</h2>
  </div>

  <div class="skill-groups">
    {Object.entries(groups).map(([key, group], index) => (
      <section class:list={["skill-group", `skill-group-${index + 1}`]} aria-labelledby={`skill-${key}`}>
        <div class="skill-group-heading">
          <span class="skill-group-number">0{index + 1}</span>
          <h3 id={`skill-${key}`}>{groupLabels[key] ?? key}</h3>
        </div>
        <ul class="skill-tags">
          {group.map((skill) => <li>{skill.name}</li>)}
        </ul>
      </section>
    ))}
  </div>
</section>
