---
import { personalInfo } from "../../data/info";
import { p5Assets } from "../../lib/p5-assets";
import P5Menu from "../P5Menu";
import type { P5MenuItem } from "../P5Menu";

const [firstName, ...lastNames] = personalInfo.nm.split(" ");
const role = personalInfo.title.split(" & ")[0];
const city = personalInfo.location.split(",")[0];
const menuItems: readonly P5MenuItem[] = [
	{ label: "About me", href: "/about" },
	{ label: "Projects", href: "/projects" },
	{ label: "Resume", href: "/resume" },
	{ label: "Contact", href: "/contact" },
];
---

<section class="home-hero" aria-labelledby="home-title">
	<div class="home-slab" aria-hidden="true"></div>

	<div class="home-identity">
		<p class="home-tag"><span>Portfolio / 2026</span></p>
		<h1 id="home-title" class="p5-display home-name">
			<span class="home-name-first">{firstName}</span>
			<span class="home-name-last">{lastNames.join(" ")}</span>
		</h1>
		<p class="home-role"><span class="p5-display">{role}</span></p>
		<p class="home-pitch">{personalInfo.tagline}</p>

		<nav class="home-actions" aria-label="Direct links">
			<a class="home-action" href="/CV_Nicolas_Moreno.pdf" download="Nicolas_Moreno_CV_AI_Engineer.pdf" aria-label="Get CV (PDF)"><span>Get CV</span></a>
			<a class="home-action home-action-ghost" href={personalInfo.socialLinks.github} target="_blank" rel="noopener noreferrer"><span>GitHub</span></a>
			<a class="home-action home-action-ghost" href={personalInfo.socialLinks.linkedin} target="_blank" rel="noopener noreferrer"><span>LinkedIn</span></a>
		</nav>

		<ul class="home-status">
			<li>{personalInfo.availability}</li>
			<li>{city}, CO</li>
			<li>{personalInfo.timezone}</li>
		</ul>
	</div>

	<div class="home-portrait">
		<div class="home-frame">
			<img
				src={p5Assets.portrait.src}
				alt={`Stylized portrait of ${personalInfo.name} under red and violet light`}
				width={p5Assets.portrait.width}
				height={p5Assets.portrait.height}
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</div>
		<P5Menu client:load items={menuItems} />
	</div>
</section>
