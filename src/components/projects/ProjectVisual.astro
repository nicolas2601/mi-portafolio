---
import { coverFor } from "../../lib/projects";
import type { ProjectRecord } from "../../lib/projects";

interface Props {
  project: ProjectRecord;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const cover = coverFor(project);
const screenshotSize = cover.kind === "screenshot" && cover.src === "/iot.png"
  ? { width: 800, height: 424 }
  : { width: 640, height: 640 };
---

<div class="project-visual">
  {
    cover.kind === "screenshot" ? (
      <figure class="project-shot">
        <img
          src={cover.src}
          width={screenshotSize.width}
          height={screenshotSize.height}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          alt={`Vista previa de ${project.title}`}
        />
        <span class="project-shot__tape" aria-hidden="true"></span>
      </figure>
    ) : (
      <div class={`project-stats ${cover.tone}`}>
        <span class="project-stats__mark" aria-hidden="true">{cover.initials}</span>
        <ul class="project-stats__list">
          {project.metrics.map((metric) => (
            <li>
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>
