---
import ProjectTitle from "./ProjectTitle.astro";
import ProjectVisual from "./ProjectVisual.astro";
import type { ProjectRecord } from "../../lib/projects";

interface Props {
  project: ProjectRecord;
  variant?: "poster" | "ticket";
  eager?: boolean;
}

const { project, variant = "ticket", eager = false } = Astro.props;
const isPoster = variant === "poster";
---

<article
  class:list={["project-item", `project-item--${variant}`]}
  data-project-item
  data-category={project.category}
>
  {isPoster && <ProjectVisual project={project} eager={eager} />}

  <div class="project-item__body">
    <p class="project-item__eyebrow">
      <span>{project.category}</span>
      {project.featured && <span class="project-item__featured">Featured</span>}
    </p>

    <ProjectTitle title={project.title} />
    <p class="project-item__description">{project.description}</p>

    {!isPoster && (
      <ul class="project-item__metrics" aria-label={`Metrics for ${project.title}`}>
        {project.metrics.map((metric) => (
          <li>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </li>
        ))}
      </ul>
    )}

    <ul class="project-item__tech" aria-label={`Technologies used in ${project.title}`}>
      {project.tech.map((technology) => <li>{technology}</li>)}
    </ul>

    {project.github && (
      <a class="project-item__github" href={project.github} target="_blank" rel="noopener noreferrer">
        View source <span class="sr-only">of {project.title}</span> <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</article>
