---
import ProjectCover from "./ProjectCover.astro";
import type { ProjectRecord } from "../../lib/projects";

interface Props {
  project: ProjectRecord;
}

const { project } = Astro.props;
---

<article
  class:list={[
    "project-item",
    project.featured && "project-item--featured",
  ]}
  data-project-item
  data-category={project.category}
>
  <ProjectCover project={project} />

  <div class="project-item__content">
    <div class="project-item__eyebrow">
      <span>{project.category}</span>
      {project.featured && <span class="project-item__featured">FEATURED</span>}
    </div>

    <h2>{project.title}</h2>
    <p class="project-item__description">{project.description}</p>

    <ul class="project-item__metrics" aria-label={`Metrics for ${project.title}`}>
      {project.metrics.map((metric) => (
        <li>
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </li>
      ))}
    </ul>

    <ul class="project-item__tech" aria-label={`Technologies used in ${project.title}`}>
      {project.tech.map((technology) => <li>{technology}</li>)}
    </ul>

    {
      project.github && (
        <a
          class="project-item__github"
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Ver código de ${project.title} en GitHub`}
        >
          VIEW SOURCE <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>
