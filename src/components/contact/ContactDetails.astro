---
import { personalInfo } from "../../data/info";
---

<aside class="contact-details" aria-labelledby="contact-details-title">
  <p class="contact-kicker">01 / OPEN CHANNEL</p>
  <h2 id="contact-details-title">Direct contact</h2>
  <p class="contact-details-intro">{personalInfo.location}</p>

  <div class="contact-detail-list">
    <a class="contact-detail-link" href={`mailto:${personalInfo.email}`}>
      <span class="contact-detail-index" aria-hidden="true">01</span>
      <span>
        <small>Email</small>
        <strong>{personalInfo.email}</strong>
      </span>
    </a>
    <a class="contact-detail-link" href={personalInfo.socialLinks.linkedin} target="_blank" rel="noopener noreferrer">
      <span class="contact-detail-index" aria-hidden="true">02</span>
      <span>
        <small>LinkedIn</small>
        <strong>nicolas-moreno-dev</strong>
      </span>
    </a>
    <a class="contact-detail-link" href={personalInfo.socialLinks.github} target="_blank" rel="noopener noreferrer">
      <span class="contact-detail-index" aria-hidden="true">03</span>
      <span>
        <small>GitHub</small>
        <strong>nicolas2601</strong>
      </span>
    </a>
    <a class="contact-detail-link" href={`tel:${personalInfo.phone.replaceAll(" ", "")}`}>
      <span class="contact-detail-index" aria-hidden="true">04</span>
      <span>
        <small>Phone</small>
        <strong>{personalInfo.phone}</strong>
      </span>
    </a>
  </div>

  <p class="contact-details-note">Available for remote work in the Americas timezone.</p>
</aside>
