---
import BackgroundMusic from "./BackgroundMusic";
import P5Background from "./P5Background.astro";
---

<div class="p5-shell">
  <P5Background />

  <header class="p5-frame-header">
    <a href="/" class="p5-frame-brand" aria-label="Nicolas Moreno home">
      <span>NM / SYSTEMS</span>
    </a>
    <div class="p5-frame-tools">
      <span class="p5-frame-meta">Bucaramanga / CO</span>
      <BackgroundMusic client:idle transition:persist="p5-music" />
    </div>
  </header>

  <div class="relative z-10">
    <slot />
  </div>

  <footer class="p5-frame-footer">
    <span class="p5-frame-footer__mark">NM / 2026</span>
    <p>Visual style inspired by Persona 5. Fan tribute, not affiliated with Atlus.</p>
  </footer>

</div>
