---
interface CertificationEntry {
  name: string;
  issuer: string;
  date: string;
  type: string;
}

interface Props {
  entries: CertificationEntry[];
}

const { entries } = Astro.props;
---

<section class="resume-section resume-certifications" aria-labelledby="certifications-title">
  <div class="resume-section-heading">
    <p class="resume-kicker">03 / CREDENTIAL INDEX</p>
    <h2 id="certifications-title">Certifications</h2>
  </div>

  <ol class="resume-certification-list">
    {entries.map((entry, index) => (
      <li class="resume-certification-row p5-reveal" style={`--delay: ${index * 45}ms`}>
        <span class="resume-row-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <div>
          <h3>{entry.name}</h3>
          <p>{entry.issuer}</p>
        </div>
        <div class="resume-certification-date">
          <span>{entry.type}</span>
          <time>{entry.date}</time>
        </div>
      </li>
    ))}
  </ol>
</section>
